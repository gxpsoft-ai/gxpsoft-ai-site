---
import Layout from './Layout.astro';
import Header from '../components/Header.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  heroImage?: string;
}

const { title, description, pubDate, updatedDate } = Astro.props;

const formattedDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Layout
  title={`${title} | GxPSoft AI Blog`}
  description={description}
  canonicalUrl={Astro.url.href}
  pageClass="page-blog-post"
>
  <Header slot="header" />

  <article class="blog-post">
    <div class="post-back">
      <a href="/blog.html" class="service-link">← Back to Blog</a>
    </div>

    <header class="post-header">
      <time datetime={pubDate.toISOString()} class="post-date">{formattedDate}</time>
      <div class="post-header-content">
        <h1>{title}</h1>
        <p class="post-description">{description}</p>
        {updatedDate && (
          <div class="last-updated">
            Last updated on {updatedDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
          </div>
        )}
      </div>
    </header>

    <div class="post-content">
      <slot />
    </div>
  </article>
</Layout>

<style is:global>
  /* Blog post details layout */
  .blog-post {
    max-width: 680px;
    margin: 0 auto;
    padding-bottom: 60px;
  }

  .post-back {
    margin-bottom: 32px;
    font-size: 13px;
  }

  .post-header {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: 32px;
    margin-bottom: 48px;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 32px;
  }

  .post-date {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding-top: 6px;
  }

  .post-header-content {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .post-header h1 {
    font-family: var(--font-serif);
    font-size: 40px;
    font-weight: 500;
    line-height: 1.2;
    margin: 0;
    color: var(--text-color);
    letter-spacing: -0.01em;
  }

  .post-description {
    font-family: var(--font-mono);
    font-size: 15px;
    color: var(--text-muted);
    line-height: 1.6;
    margin: 0;
  }

  .last-updated {
    font-style: italic;
    font-size: 12px;
    color: var(--text-muted);
    margin-top: 4px;
  }

  @media (max-width: 640px) {
    .post-header {
      grid-template-columns: 1fr;
      gap: 16px;
      padding-bottom: 24px;
      margin-bottom: 32px;
    }
    .post-date {
      padding-top: 0;
      border-bottom: 1px solid var(--border-color);
      padding-bottom: 8px;
    }
  }

  /* Typography inside markdown content */
  .post-content p {
    font-family: var(--font-mono);
    font-size: 14px;
    line-height: 1.7;
    color: var(--text-muted);
    margin-bottom: 24px;
  }

  .post-content h2 {
    font-family: var(--font-serif);
    font-size: 24px;
    font-weight: 500;
    color: var(--text-color);
    margin: 40px 0 16px;
    line-height: 1.3;
  }

  .post-content h3 {
    font-family: var(--font-serif);
    font-size: 20px;
    font-weight: 500;
    color: var(--text-color);
    margin: 32px 0 12px;
    line-height: 1.3;
  }

  .post-content ul, .post-content ol {
    margin-bottom: 24px;
    padding-left: 24px;
  }

  .post-content li {
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--text-muted);
    margin-bottom: 8px;
    line-height: 1.6;
  }

  .post-content blockquote {
    border-left: 3px solid var(--text-color);
    padding-left: 20px;
    margin: 32px 0;
    font-style: italic;
  }

  .post-content blockquote p {
    color: var(--text-color);
    font-size: 15px;
  }

  .post-content a {
    text-underline-offset: 4px;
    color: var(--text-color);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    -webkit-text-decoration-color: var(--underline-color);
    text-decoration-color: var(--underline-color);
    transition: text-decoration-color 0.2s, color 0.2s;
  }

  .post-content a:hover {
    -webkit-text-decoration-color: var(--underline-hover);
    text-decoration-color: var(--underline-hover);
  }

  .post-content pre {
    margin: 24px 0;
    padding: 16px;
    background-color: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: 4px;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.5;
  }

  /* Code highlights */
  .post-content code {
    font-family: var(--font-mono);
    font-size: 13px;
    background-color: var(--card-bg);
    padding: 2px 6px;
    border-radius: 3px;
    border: 1px solid var(--border-color);
  }

  .post-content pre code {
    background-color: transparent;
    padding: 0;
    border: none;
    border-radius: 0;
  }

  .post-content img {
    max-width: 100%;
    height: auto;
    border-radius: 4px;
    border: 1px solid var(--border-color);
    margin: 32px 0;
  }
</style>
