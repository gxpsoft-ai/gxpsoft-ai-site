---
import '../styles/style.css';
import JsonLd from '../components/JsonLd.astro';

interface Props {
  title: string;
  description: string;
  canonicalUrl: string;
  ogImage?: string;
  pageClass?: string;
  schema?: Record<string, any> | Array<Record<string, any>>;
}

const { 
  title, 
  description, 
  canonicalUrl, 
  ogImage = 'https://gxpsoft.ai/images/gxpsoft_og_image_v3.png', 
  pageClass,
  schema
} = Astro.props;

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "GxPSoft AI",
  "url": "https://gxpsoft.ai",
  "logo": "https://gxpsoft.ai/logo.png",
  "parentOrganization": {
    "@type": "Organization",
    "name": "Saram Consulting",
    "url": "https://saram.io"
  },
  "sameAs": [
    "https://github.com/gxpsoft-ai"
  ]
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "GxPSoft AI",
  "url": "https://gxpsoft.ai"
};

const pageSchemas = schema
  ? [organizationSchema, websiteSchema, ...(Array.isArray(schema) ? schema : [schema])]
  : [organizationSchema, websiteSchema];
---

<!doctype html>
<html lang="en">
  <head>
    <script is:inline>
      (function() {
        const savedTheme = localStorage.getItem('theme-pref') || 'system';
        if (savedTheme === 'system') {
          const isDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.setAttribute('data-theme', isDark ? 'dark' : 'light');
        } else {
          document.documentElement.setAttribute('data-theme', savedTheme);
        }
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title="GxPSoft AI Blog RSS Feed" href="https://gxpsoft.ai/rss.xml" />
    <JsonLd schema={pageSchemas} />

    <!-- Open Graph / Social Media Preview -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="GxPSoft AI" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="/favicon.ico" type="image/x-icon" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Roboto+Mono:ital,wght@0,100..700;1,100..700&display=swap" rel="stylesheet">
  </head>
  <body>
    <div class={`container ${pageClass || ''}`}>
      <!-- Promo Banner -->
      <div class="promo-banner" id="promoBanner">
        <span class="promo-tag">OpenBio News</span>
        <span class="promo-text">
          Our partner platform for decentralized biotechnology intelligence. <a href="https://openbionews.com" target="_blank" rel="noopener noreferrer" class="promo-link">Visit OpenBio News</a>
        </span>
      </div>

      <slot name="header" />

      <main id="mainContent">
        <slot />
      </main>

      <footer id="mainFooter">
        GxPSoft AI is a subsidiary of <a href="https://saram.io" class="service-link" target="_blank" rel="noopener noreferrer">Saram Consulting</a>. 100% automated by Hermes Agent
      </footer>
    </div>
  </body>
</html>
