---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
---

<Layout
  title="SOP Writer | Copy Clean AI Content Into Corporate Templates"
  description="SOP Writer solves the clipboard tax: generate GxP procedures that copy into rigid, fragile corporate Word templates without breaking lists, headings, or styles."
  canonicalUrl="https://gxpsoft.ai/sopwriter.html"
  ogImage="https://gxpsoft.ai/images/sopwriter_og_image_v3.png"
  pageClass="page-sopwriter"
>
  <Header slot="header" />

  <section class="hero-text subpage-hero" id="heroSection">
    <h1>SOP Writer: Focus on Content, Not Broken Templates</h1>
    
    <div class="alpha-banner" id="alphaBanner">
      <span class="alpha-tag">Early Alpha</span>
      <span class="alpha-text">SOP Writer is under active development. Try it live at <a href="https://sopwriter.gxpsoft.ai" target="_blank" rel="noopener noreferrer" style="color: inherit; text-decoration: underline;">sopwriter.gxpsoft.ai</a>.</span>
    </div>

    <p>
      If you've tried using ChatGPT or Claude to draft SOPs, you know the frustration: you get a great draft, but the moment you copy and paste it into your rigid corporate Word or PDF template, everything breaks.
    </p>
    <p>
      Headings turn into standard paragraphs. Nested lists lose their indentation levels. Custom styling shifts, leaving you with hours of manual re-formatting. 
    </p>
    <p>
      <strong>SOP Writer solves this.</strong> It strips away formatting noise and outputs clean, semantic structures designed specifically to be pasted directly into fragile corporate templates without breaking their layouts.
    </p>
  </section>

  <section id="pipelineSection">
    <p class="section-title">How It Works</p>
    <p style="margin-bottom: 16px; font-size: 13px; opacity: 0.8;">
      Write, generate, and copy without formatting headaches in five steps.
    </p>

    <div class="pipeline-container">
      <div class="pipeline-steps" id="pipelineSteps">
        <button class="pipeline-step active" data-step="0">
          <span class="pipeline-step-number">01</span>
          <span class="pipeline-step-title">Specify Target Format</span>
        </button>
        <button class="pipeline-step" data-step="1">
          <span class="pipeline-step-number">02</span>
          <span class="pipeline-step-title">Provide Raw Process Steps</span>
        </button>
        <button class="pipeline-step" data-step="2">
          <span class="pipeline-step-number">03</span>
          <span class="pipeline-step-title">AI Content-Only Drafting</span>
        </button>
        <button class="pipeline-step" data-step="3">
          <span class="pipeline-step-number">04</span>
          <span class="pipeline-step-title">Structure-Purity Copy</span>
        </button>
        <button class="pipeline-step" data-step="4">
          <span class="pipeline-step-number">05</span>
          <span class="pipeline-step-title">Paste & Match Style</span>
        </button>
      </div>

      <div class="pipeline-detail" id="pipelineDetail">
        <h3 class="pipeline-detail-title" id="pipelineTitle">01. Specify Target Format</h3>
        <p class="pipeline-detail-text" id="pipelineDesc">
          Set up the layout expectation. Tell the writer how your corporate document structures headings and lists so it understands how to isolate the text semantic layers.
        </p>
      </div>
    </div>
  </section>

  <section id="featuresSection">
    <p class="section-title">Core Features</p>
    <div class="features-grid">
      <div class="feature-card">
        <h3>Clipboard Preservation</h3>
        <p>No more headers collapsing into paragraphs. SOP Writer outputs clean tags that corporate templates (like Microsoft Word or Google Docs) recognize as semantic structural layers, adopting your target styles instantly.</p>
      </div>
      <div class="feature-card">
        <h3>Nested List Alignment</h3>
        <p>Multi-level bullet points and numbered lists are the first thing to break when copying from standard LLMs. SOP Writer formats lists with precise spacing and structure-only HTML/markdown, preserving indentation levels.</p>
      </div>
      <div class="feature-card">
        <h3>Formatting Stripped</h3>
        <p>Hidden margins, background colors, and custom fonts are stripped away. You are left with pure, structured text that matches the exact styles, margins, and headers of the document you paste it into.</p>
      </div>
      <div class="feature-card">
        <h3>GxP Content Focus</h3>
        <p>Rather than wrestling with Microsoft Word margins, your engineers can focus purely on writing the operational procedures, ensuring accurate GxP instructions without formatting distractions.</p>
      </div>
    </div>
  </section>

  <section id="pricingSection">
    <p class="section-title">Pricing</p>
    <div class="pricing-card">
      <div class="pricing-info">
        <span class="pricing-badge">Free Alpha</span>
        <h3>Zero Layout Struggles</h3>
        <p class="pricing-description">
          Use SOP Writer for free during the alpha phase. Try pasting generated procedures into your own rigid templates and see the difference.
        </p>
      </div>
      <div class="pricing-rate">
        <div class="price-display">
          <span class="price-amount">$0.00</span>
          <span class="price-period">/ month</span>
        </div>
        <p class="pricing-note">Free access during early alpha.</p>
      </div>
    </div>
  </section>

  <section id="contactSection">
    <p class="section-title">Ready to Try It?</p>
    <p class="section-text">
      Start writing and pasting clean SOPs right now at <a href="https://sopwriter.gxpsoft.ai" target="_blank" rel="noopener noreferrer" class="service-link">sopwriter.gxpsoft.ai</a>.
    </p>
    <p class="section-text" style="margin-top: 12px;">
      Want a custom template mapping script or integration with your corporate document control system? Reach out to us.
    </p>
    <p class="section-text" style="margin-top: 8px;">
      Email:
      <a href="mailto:duke.lee@saram.io" class="service-link" id="emailLink">duke.lee@saram.io</a>
    </p>
    <p class="section-text">
      Phone:
      <a href="tel:+19253946606" class="service-link" id="phoneLink">925 394-6606</a>
    </p>
  </section>
</Layout>

<script>
  interface PipelineStep {
    number: string;
    title: string;
    description: string;
  }

  const pipelineStepsData: PipelineStep[] = [
    {
      number: "01",
      title: "Specify Target Format",
      description: "Set up the layout expectation. Tell the writer how your corporate document structures headings and lists so it understands how to isolate the text semantic layers."
    },
    {
      number: "02",
      title: "Provide Raw Process Steps",
      description: "Input your raw procedural notes, equipment specs, or process steps. Focus entirely on content details, ignoring indentation or styling requirements."
    },
    {
      number: "03",
      title: "AI Content-Only Drafting",
      description: "The AI agent drafts the SOP, focusing purely on semantic hierarchy (e.g. H1, H2, Level 1 List, Level 2 List) without applying any custom colors, fonts, or margin styles."
    },
    {
      number: "04",
      title: "Structure-Purity Copy",
      description: "Click copy to capture the procedure in a clean, structure-only format. SOP Writer removes the formatting tags that cause standard LLM text to collide with corporate templates."
    },
    {
      number: "05",
      title: "Paste & Match Style",
      description: "Paste the draft directly into your rigid corporate Word or PDF template. The text adopts your template's built-in styles instantly without breaking list alignment or margin configurations."
    }
  ];

  function initPipeline() {
    const steps = document.querySelectorAll(".pipeline-step");
    const title = document.getElementById("pipelineTitle");
    const desc = document.getElementById("pipelineDesc");
    const detailContainer = document.getElementById("pipelineDetail");
    let activeIndex = 0;

    if (!title || !desc || !detailContainer) return;

    steps.forEach((btn, idx) => {
      btn.addEventListener("click", () => {
        if (idx === activeIndex) return;

        activeIndex = idx;
        steps.forEach((step, sIdx) => {
          step.classList.remove("active", "completed");
          if (sIdx === activeIndex) {
            step.classList.add("active");
          } else if (sIdx < activeIndex) {
            step.classList.add("completed");
          }
        });

        detailContainer.classList.add("transitioning");
        setTimeout(() => {
          const data = pipelineStepsData[activeIndex];
          if (data) {
            title.textContent = `${data.number}. ${data.title}`;
            desc.textContent = data.description;
          }
          detailContainer.classList.remove("transitioning");
        }, 120);
      });
    });
  }

  // Initialize immediately or on load
  if (document.readyState === 'loading') {
    document.addEventListener("DOMContentLoaded", initPipeline);
  } else {
    initPipeline();
  }
</script>
