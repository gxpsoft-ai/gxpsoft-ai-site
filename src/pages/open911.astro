---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
---

<Layout
  title="Open911 | GxP-Compliant OPC UA Alarm Notification System"
  description="Open911 is a reliable, FDA 21 CFR Part 11 ready alarm notification platform that forwards critical industrial OPC UA tags and alarms to operators."
  canonicalUrl="https://gxpsoft.ai/open911.html"
  ogImage="https://gxpsoft.ai/images/open911_og_image_v3.png"
  pageClass="page-open911"
>
  <Header slot="header" />

  <section class="hero-text subpage-hero" id="heroSection">
    <h1>Open911: Industrial OPC UA Alarm Notification System</h1>
    <p>
      Open911 is a GxP-compliant, robust, and highly configurable alert dispatching
      system. Designed for life sciences, biotechnology, and manufacturing environments,
      it connects natively with OPC UA infrastructure to monitor critical operational
      tags and coordinate instant operator response.
    </p>
    <p>
      Functioning similarly to Win-911, Open911 closes the gap between automation
      control systems and plant personnel, ensuring critical events are resolved promptly
      through intelligent escalation rules, shift calendars, and reliable multi-channel
      deliveries.
    </p>
  </section>

  <section id="tourSection">
    <p class="section-title">Product Interface Tour</p>
    <p style="margin-bottom: 16px; font-size: 13px; opacity: 0.8;">
      Select a module from the menu below to preview its interface. Click the screenshot
      to view it in full resolution.
    </p>

    <div class="tour-container">
      <div class="tour-sidebar" id="tourSidebar">
        <button class="tour-tab active" data-tab="dashboard">01. System Dashboard</button>
        <button class="tour-tab" data-tab="tag-explorer">02. OPC UA Tag Explorer</button>
        <button class="tour-tab" data-tab="gateway-settings">03. Gateway Settings</button>
        <button class="tour-tab" data-tab="contacts">04. Contact Directory</button>
        <button class="tour-tab" data-tab="user-groups">05. User Groups</button>
        <button class="tour-tab" data-tab="on-calls">06. On-Call Scheduling</button>
        <button class="tour-tab" data-tab="escalation-policy">07. Alarm Escalation Policies</button>
        <button class="tour-tab" data-tab="system-diag">08. System Diagnostics</button>
        <button class="tour-tab" data-tab="audit-trail">09. GxP Audit Trail</button>
      </div>

      <div class="tour-stage">
        <div class="screenshot-wrapper" id="tourScreenshotWrapper" role="button" tabindex="0">
          <img
            id="tourImage"
            src="/images/open911_dashboard.png"
            alt="Open911 System Dashboard"
            class="tour-image"
          />
        </div>
        <div class="tour-description" id="tourDescription">
          <h3 class="tour-detail-title" id="tourTitle">System Dashboard</h3>
          <p class="tour-detail-text" id="tourDesc">The central command hub for Open911. It displays active and unresolved alarms, live connection statuses for OPC UA servers, notification gateway health, and currently active on-call staff. A clean layout ensures that critical operational statuses are visible at a glance without clutter.</p>
        </div>
      </div>
    </div>
  </section>

  <section id="featuresSection">
    <p class="section-title">Core System Features</p>
    <div class="features-grid">
      <div class="feature-card">
        <h3>Direct OPC UA Browsing</h3>
        <p>Leverage the built-in Tag Explorer to directly browse hierarchical OPC UA namespaces. Rapidly configure triggers on data tags, status codes, and quality indicators without manual entry mistakes.</p>
      </div>
      <div class="feature-card">
        <h3>GxP Compliance Ready</h3>
        <p>Comply with strict regulatory frameworks, including FDA 21 CFR Part 11. Open911 includes a read-only, cryptographically linked Audit Trail, tracking all alarms, alerts, and operator responses.</p>
      </div>
      <div class="feature-card">
        <h3>Intelligent Escalation</h3>
        <p>Configure custom rules to escalate alerts based on response latency. Define fallback notification steps across multiple groups and individuals to guarantee alarms are acknowledged.</p>
      </div>
      <div class="feature-card">
        <h3>Shift & Schedule Awareness</h3>
        <p>Use active calendar schedules to route alarms only to active on-call operators, mitigating notification fatigue and ensuring off-shift employees are not disrupted.</p>
      </div>
    </div>
  </section>

  <section id="contactSection">
    <p class="section-title">Inquire About Open911</p>
    <p class="section-text">
      We provide full deployment support, GxP computer system validation (CSV) protocols,
      and customization options for Open911.
    </p>
    <p class="section-text" style="margin-top: 8px;">
      Email:
      <a href="mailto:duke.lee@saram.io" class="service-link" id="emailLink">duke.lee@saram.io</a>
    </p>
    <p class="section-text">
      Phone:
      <a href="tel:+19253946606" class="service-link" id="phoneLink">925 394-6606</a>
    </p>
  </section>

  <!-- Lightbox Overlay -->
  <div class="lightbox" id="lightbox">
    <button class="lightbox-close" id="lightboxClose">Close [Esc]</button>
    <div class="lightbox-content">
      <img src="/images/open911_dashboard.png" alt="Open911 System Dashboard" class="lightbox-image" id="lightboxImage" />
    </div>
  </div>
</Layout>

<script>
  interface TourItem {
    title: string;
    src: string;
    desc: string;
  }

  const tourData: Record<string, TourItem> = {
    dashboard: {
      title: "System Dashboard",
      src: "/images/open911_dashboard.png",
      desc: "The central command hub for Open911. It displays active and unresolved alarms, live connection statuses for OPC UA servers, notification gateway health, and currently active on-call staff. A clean layout ensures that critical operational statuses are visible at a glance without clutter."
    },
    "tag-explorer": {
      title: "OPC UA Tag Explorer",
      src: "/images/open911_tag_explorer.png",
      desc: "An intuitive tag browser that connects directly to your OPC UA server. Engineers can browse the OPC UA namespace hierarchical structure, select specific tags, and configure alarm conditions (such as high/low limits, status changes, or quality changes) without needing to manually copy node IDs."
    },
    "gateway-settings": {
      title: "Gateway Settings",
      src: "/images/open911_gateway_settings.png",
      desc: "The communication engine configuration page. Open911 supports multiple notification channels including SMTP Email, SMS text gateways, Voice/Phone calls (via Twilio or local hardware modems), and OPC UA feedback loops. Gateways can be configured with failover paths to ensure alert delivery."
    },
    contacts: {
      title: "Contact Directory",
      src: "/images/open911_contacts.png",
      desc: "A central registry for all system operators and technicians. Define each individual's contact information, preferred communication channels (e.g., SMS first, then Voice), and specific connection parameters. Individual contact details are encrypted in compliance with internal security guidelines."
    },
    "user-groups": {
      title: "User Groups",
      src: "/images/open911_user_groups.png",
      desc: "Organizes operators and technicians into logical groups based on departments, responsibilities, or physical plant zones (e.g., \"HVAC Technicians\", \"Line 3 Operators\"). User groups simplify alert routing, allowing alarms to be sent to entire teams simultaneously."
    },
    "on-calls": {
      title: "On-Call Scheduling",
      src: "/images/open911_on_calls.png",
      desc: "A comprehensive calendar and shift planner to define who is active. Open911 references these schedules in real-time, ensuring alerts are only sent to personnel currently on shift, avoiding notification fatigue for off-duty employees."
    },
    "escalation-policy": {
      title: "Alarm Escalation Policies",
      src: "/images/open911_escalation_policy.png",
      desc: "Defines the automated sequence of notification steps when an alarm is triggered. For example, the policy can email Operator A, wait 5 minutes, and if the alarm is not acknowledged, escalate by sending an SMS to Operator B, and finally place a phone call to the Shift Supervisor."
    },
    "system-diag": {
      title: "System Diagnostics",
      src: "/images/open911_system_diag.png",
      desc: "Real-time diagnostic panel displaying active telemetry, connection status to OPC UA servers, API performance, and memory usage. System diagnostics allow administrators to quickly troubleshoot networking issues and trace notification delivery status."
    },
    "audit-trail": {
      title: "GxP Audit Trail",
      src: "/images/open911_audit_trail.png",
      desc: "A tamper-evident, chronologically sequenced event log required for regulatory compliance (FDA 21 CFR Part 11). It records all alarm triggers, responder deliveries, user acknowledgments, configuration changes, and system restarts with high-precision timestamps."
    }
  };

  function initTour() {
    const tabs = document.querySelectorAll(".tour-tab");
    const tourImage = document.getElementById("tourImage") as HTMLImageElement | null;
    const tourTitle = document.getElementById("tourTitle");
    const tourDesc = document.getElementById("tourDesc");
    const tourDescriptionContainer = document.getElementById("tourDescription");
    const wrapper = document.getElementById("tourScreenshotWrapper");
    const lightbox = document.getElementById("lightbox");
    const lightboxImage = document.getElementById("lightboxImage") as HTMLImageElement | null;
    const lightboxClose = document.getElementById("lightboxClose");
    let activeTab = "dashboard";

    if (!tourImage || !tourTitle || !tourDesc || !tourDescriptionContainer || !wrapper || !lightbox || !lightboxImage || !lightboxClose) {
      return;
    }

    tabs.forEach(tab => {
      tab.addEventListener("click", () => {
        const currentTab = tab.getAttribute("data-tab");
        if (!currentTab || currentTab === activeTab) return;

        activeTab = currentTab;
        tabs.forEach(btn => btn.classList.remove("active"));
        tab.classList.add("active");

        // Transitions
        tourImage.classList.add("transitioning");
        tourDescriptionContainer.classList.add("transitioning");

        setTimeout(() => {
          const data = tourData[currentTab];
          if (data) {
            tourImage.src = data.src;
            tourImage.alt = `Open911 ${data.title}`;
            tourTitle.textContent = data.title;
            tourDesc.textContent = data.desc;
            lightboxImage.src = data.src;
            lightboxImage.alt = `Open911 ${data.title}`;
          }
          tourImage.classList.remove("transitioning");
          tourDescriptionContainer.classList.remove("transitioning");
        }, 150);
      });
    });

    // Lightbox bindings
    const showLightbox = () => {
      lightbox.classList.add("active");
      document.body.style.overflow = "hidden";
    };
    const hideLightbox = () => {
      lightbox.classList.remove("active");
      document.body.style.overflow = "";
    };

    wrapper.addEventListener("click", showLightbox);
    lightboxClose.addEventListener("click", hideLightbox);
    lightbox.addEventListener("click", (e) => {
      if (e.target === lightbox) hideLightbox();
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && lightbox.classList.contains("active")) hideLightbox();
    });
  }

  // Initialize immediately or on load
  if (document.readyState === 'loading') {
    document.addEventListener("DOMContentLoaded", initTour);
  } else {
    initTour();
  }
</script>
