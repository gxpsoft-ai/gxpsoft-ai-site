---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout
  title="Blog | GxPSoft AI"
  description="Thoughts on autonomous AI agents, GxP validation, secure backups, and developer tools for critical systems."
  canonicalUrl="https://gxpsoft.ai/blog.html"
  pageClass="page-blog"
>
  <Header slot="header" />

  <section class="hero-text" id="blogHero">
    <h1>GxPSoft AI Blog</h1>
    <p>Articles and insights from our team on autonomous software engineering, industrial systems, and GxP compliance automation.</p>
  </section>

  <section id="postsSection">
    <p class="section-title">Latest Articles</p>
    <div class="posts-list">
      {posts.length === 0 ? (
        <p class="no-posts">No articles published yet. Check back soon!</p>
      ) : (
        posts.map((post) => (
          <article class="post-card">
            <div class="post-card-meta">
              <time datetime={post.data.pubDate.toISOString()} class="post-card-date">
                {post.data.pubDate.toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'short',
                  day: '2-digit',
                })}
              </time>
              {post.data.author && <div class="post-card-author">{post.data.author}</div>}
            </div>
            <div class="post-card-body">
              <h2 class="post-card-title">
                <a href={`/blog/${post.slug}.html`} class="post-card-link">
                  {post.data.title}
                </a>
              </h2>
              <p class="post-card-description">{post.data.description}</p>
            </div>
          </article>
        ))
      )}
    </div>
  </section>
</Layout>

<style>
  .posts-list {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin-top: 32px;
  }

  .post-card {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: 32px;
    padding: 32px 0;
    border-top: 1px solid var(--border-color);
    transition: transform 0.2s ease;
  }

  .post-card:first-of-type {
    border-top: none;
    padding-top: 12px;
  }

  .post-card:hover {
    transform: translateX(6px);
  }

  .post-card-body {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .post-card-meta {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-top: 6px;
  }

  .post-card-date {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-muted);
    letter-spacing: 0.05em;
    margin: 0;
  }

  .post-card-author {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-muted);
    line-height: 1.4;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-left: 1px solid var(--border-color);
    padding-left: 8px;
  }

  .post-card-title {
    font-family: var(--font-serif);
    font-size: 24px;
    font-weight: 500;
    line-height: 1.3;
  }

  .post-card-link {
    color: var(--text-color);
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .post-card-link:hover {
    opacity: 0.8;
  }

  .post-card-description {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-muted);
    line-height: 1.6;
    margin: 0;
  }

  .no-posts {
    font-family: var(--font-mono);
    color: var(--text-muted);
    font-style: italic;
  }

  @media (max-width: 640px) {
    .post-card {
      grid-template-columns: 1fr;
      gap: 12px;
      padding: 24px 0;
    }
    .post-card:hover {
      transform: none;
    }
    .post-card-meta {
      padding-top: 0;
      flex-direction: row;
      align-items: center;
      gap: 16px;
      border-bottom: 1px solid var(--border-color);
      padding-bottom: 12px;
    }
    .post-card-author {
      border-left: 1px solid var(--border-color);
      padding-left: 16px;
    }
  }
</style>
