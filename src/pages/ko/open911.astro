---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';

const open911Schema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Open911",
  "operatingSystem": "Linux, Windows, OPC UA 호환",
  "applicationCategory": "IndustrialAutomationApplication",
  "description": "Open911은 생명과학, 생명공학 및 제조 환경을 위한 신뢰성 높고 FDA 21 CFR Part 11을 지원하는 OPC UA 알람 통보 플랫폼입니다.",
  "url": "https://gxpsoft.ai/ko/open911.html",
  "author": {
    "@type": "Organization",
    "name": "GxPSoft AI"
  }
};
---

<Layout
  title="Open911 | GxP 규제 준수 OPC UA 알람 통보 시스템"
  description="Open911은 중요 산업 OPC UA 태그 및 알람을 작업자에게 전달하는 신뢰성 높고 FDA 21 CFR Part 11을 지원하는 알람 통보 플랫폼입니다."
  canonicalUrl="https://gxpsoft.ai/ko/open911.html"
  ogImage="https://gxpsoft.ai/images/open911_og_image_v3.png"
  pageClass="page-open911"
  schema={open911Schema}
  locale="ko"
>
  <Header slot="header" />

  <section class="hero-text subpage-hero" id="heroSection">
    <h1>Open911: 산업용 OPC UA 알람 통보 시스템</h1>
    <p>
      Open911은 GxP를 준수하는 견고하고 유연한 경보 발송 시스템입니다.
      생명과학, 생명공학 및 제조 환경을 위해 설계되었으며, OPC UA 인프라와
      기본적으로 연결되어 중요 운영 태그를 모니터링하고 작업자의 즉각적인 대응을 조율합니다.
    </p>
    <p>
      Win-911과 유사하게 작동하는 Open911은 자동화 제어 시스템과 공장 운영 인력 간의
      간극을 좁혀주며, 지능형 에스컬레이션 규칙, 교대근무 일정, 신뢰할 수 있는
      다채널 전송을 통해 중요 이벤트를 신속하게 해결하도록 보장합니다.
    </p>
  </section>

  <section id="tourSection">
    <h2 class="section-title">제품 인터페이스 둘러보기</h2>
    <p style="margin-bottom: 16px; font-size: 13px; opacity: 0.8;">
      아래 메뉴에서 모듈을 선택하여 인터페이스를 미리 확인하세요. 스크린샷을 클릭하면 전체 화면으로 볼 수 있습니다.
    </p>

    <div class="tour-container">
      <div class="tour-sidebar" id="tourSidebar">
        <button class="tour-tab active" data-tab="dashboard">01. 시스템 대시보드</button>
        <button class="tour-tab" data-tab="tag-explorer">02. OPC UA 태그 탐색기</button>
        <button class="tour-tab" data-tab="gateway-settings">03. 게이트웨이 설정</button>
        <button class="tour-tab" data-tab="contacts">04. 연락처 디렉터리</button>
        <button class="tour-tab" data-tab="user-groups">05. 사용자 그룹</button>
        <button class="tour-tab" data-tab="on-calls">06. 당직 일정 관리</button>
        <button class="tour-tab" data-tab="escalation-policy">07. 알람 에스컬레이션 정책</button>
        <button class="tour-tab" data-tab="system-diag">08. 시스템 진단</button>
        <button class="tour-tab" data-tab="audit-trail">09. GxP 감사 추적</button>
      </div>

      <div class="tour-stage">
        <div class="screenshot-wrapper" id="tourScreenshotWrapper" role="button" tabindex="0">
          <img
            id="tourImage"
            src="/images/open911_dashboard.png"
            alt="Open911 시스템 대시보드"
            class="tour-image"
          />
        </div>
        <div class="tour-description" id="tourDescription">
          <h3 class="tour-detail-title" id="tourTitle">시스템 대시보드</h3>
          <p class="tour-detail-text" id="tourDesc">Open911의 중앙 관제 허브입니다. 활성 및 미해결 알람, OPC UA 서버와의 실시간 연결 상태, 알림 게이트웨이 건전성, 현재 근무 중인 당직 인원을 표시합니다. 깔끔한 레이아웃으로 중요 운영 상태를 한눈에 파악할 수 있습니다.</p>
        </div>
      </div>
    </div>
  </section>

  <section id="featuresSection">
    <h2 class="section-title">핵심 시스템 기능</h2>
    <div class="features-grid">
      <div class="feature-card">
        <h3>직접 OPC UA 탐색</h3>
        <p>내장된 태그 탐색기를 통해 계층형 OPC UA 네임스페이스를 직접 탐색할 수 있습니다. 수동 입력 실수 없이 데이터 태그, 상태 코드, 품질 지표에 대한 트리거를 신속하게 설정합니다.</p>
      </div>
      <div class="feature-card">
        <h3>GxP 규제 준수 지원</h3>
        <p>FDA 21 CFR Part 11을 포함한 엄격한 규제 프레임워크를 준수합니다. Open911에는 모든 알람, 알림 발송 및 작업자 응답을 추적하는 읽기 전용의 암호화 검증 감사 추적(Audit Trail)이 포함되어 있습니다.</p>
      </div>
      <div class="feature-card">
        <h3>지능형 에스컬레이션</h3>
        <p>응답 지연 시간에 따라 경보를 상위 단계로 전달하는 맞춤 규칙을 구성합니다. 여러 그룹과 개인에 걸친 대체 알림 단계를 정의하여 알람 확인을 보장합니다.</p>
      </div>
      <div class="feature-card">
        <h3>교대 및 근무 일정 인식</h3>
        <p>활성 캘린더 일정을 활용하여 현재 교대 근무 중인 담당자에게만 알람을 전달함으로써 알림 피로를 줄이고 비근무 직원의 방해를 방지합니다.</p>
      </div>
    </div>
  </section>

  <section id="contactSection">
    <h2 class="section-title">Open911 도입 문의</h2>
    <p class="section-text">
      Open911에 대한 전체 배포 지원, GxP 컴퓨터 시스템 검증(CSV) 프로토콜 및 커스터마이징 옵션을 제공합니다.
    </p>
    <p class="section-text" style="margin-top: 8px;">
      이메일:
      <a href="mailto:duke.lee@saram.io" class="service-link" id="emailLink">duke.lee@saram.io</a>
    </p>
    <p class="section-text">
      전화:
      <a href="tel:+19253946606" class="service-link" id="phoneLink">925 394-6606</a>
    </p>
  </section>

  <!-- Lightbox Overlay -->
  <div class="lightbox" id="lightbox">
    <button class="lightbox-close" id="lightboxClose">닫기 [Esc]</button>
    <div class="lightbox-content">
      <img src="/images/open911_dashboard.png" alt="Open911 시스템 대시보드" class="lightbox-image" id="lightboxImage" />
    </div>
  </div>
</Layout>

<script>
  interface TourItem {
    title: string;
    src: string;
    desc: string;
  }

  const tourData: Record<string, TourItem> = {
    dashboard: {
      title: "시스템 대시보드",
      src: "/images/open911_dashboard.png",
      desc: "Open911의 중앙 관제 허브입니다. 활성 및 미해결 알람, OPC UA 서버와의 실시간 연결 상태, 알림 게이트웨이 건전성, 현재 근무 중인 당직 인원을 표시합니다. 깔끔한 레이아웃으로 중요 운영 상태를 한눈에 파악할 수 있습니다."
    },
    "tag-explorer": {
      title: "OPC UA 태그 탐색기",
      src: "/images/open911_tag_explorer.png",
      desc: "OPC UA 서버에 직접 연결되는 직관적인 태그 브라우저입니다. 엔지니어는 OPC UA 네임스페이스의 계층 구조를 탐색하고 특정 태그를 선택하여 수동 노드 ID 복사 없이 경보 조건(상한/하한, 상태 변경, 품질 변경 등)을 구성할 수 있습니다."
    },
    "gateway-settings": {
      title: "게이트웨이 설정",
      src: "/images/open911_gateway_settings.png",
      desc: "통신 엔진 구성 페이지입니다. Open911은 SMTP 이메일, SMS 문자 게이트웨이, 음성/전화 통화(Twilio 또는 로컬 하드웨어 모뎀), OPC UA 피드백 루프를 포함한 다양한 알림 채널을 지원합니다. 장애 조치(failover) 경로를 설정하여 알림 전달을 보장할 수 있습니다."
    },
    contacts: {
      title: "연락처 디렉터리",
      src: "/images/open911_contacts.png",
      desc: "모든 시스템 운영자 및 기술자를 위한 중앙 등록부입니다. 각 담당자의 연락처 정보, 선호하는 통신 채널(예: SMS 우선, 이후 음성 통화) 및 특정 연결 매개변수를 정의합니다. 개별 연락처 세부정보는 내부 보안 가이드라인에 따라 암호화됩니다."
    },
    "user-groups": {
      title: "사용자 그룹",
      src: "/images/open911_user_groups.png",
      desc: "운영자와 기술자를 부서, 업무 역할 또는 공장 구역(예: \"공조(HVAC) 기술팀\", \"3호 라인 운영자\")별 논리 그룹으로 구성합니다. 사용자 그룹은 경보 라우팅을 단순화하여 팀 전체에 동시에 알람을 전송할 수 있게 합니다."
    },
    "on-calls": {
      title: "당직 일정 관리",
      src: "/images/open911_on_calls.png",
      desc: "근무 인원을 지정하기 위한 종합 캘린더 및 교대 일정 플래너입니다. Open911은 이 일정을 실시간으로 참조하여 현재 근무 중인 담당자에게만 알림을 전송함으로써 비번 직원의 알림 피로를 방지합니다."
    },
    "escalation-policy": {
      title: "알람 에스컬레이션 정책",
      src: "/images/open911_escalation_policy.png",
      desc: "알람 발생 시 자동화된 알림 단계 순서를 정의합니다. 예를 들어, 담당자 A에게 이메일을 발송하고 5분 동안 대기한 후 알람 확인이 없을 경우 담당자 B에게 SMS를 보내고, 최종적으로 교대 관리자에게 전화를 거는 정책을 구성할 수 있습니다."
    },
    "system-diag": {
      title: "시스템 진단",
      src: "/images/open911_system_diag.png",
      desc: "실시간 원격 측정 데이터, OPC UA 서버 연결 상태, API 성능 및 메모리 사용량을 표시하는 진단 패널입니다. 시스템 진단을 통해 관리자는 네트워크 문제를 신속하게 해결하고 알림 전송 상태를 추적할 수 있습니다."
    },
    "audit-trail": {
      title: "GxP 감사 추적",
      src: "/images/open911_audit_trail.png",
      desc: "규제 준수(FDA 21 CFR Part 11)에 필수적인 위변조 방지 시계열 이벤트 로그입니다. 모든 알람 트리거, 수신자 전달, 사용자 확인, 구성 변경 및 시스템 재시작을 정밀한 타임스탬프와 함께 기록합니다."
    }
  };

  function initTour() {
    const tabs = document.querySelectorAll(".tour-tab");
    const tourImage = document.getElementById("tourImage") as HTMLImageElement | null;
    const tourTitle = document.getElementById("tourTitle");
    const tourDesc = document.getElementById("tourDesc");
    const tourDescriptionContainer = document.getElementById("tourDescription");
    const wrapper = document.getElementById("tourScreenshotWrapper");
    const lightbox = document.getElementById("lightbox");
    const lightboxImage = document.getElementById("lightboxImage") as HTMLImageElement | null;
    const lightboxClose = document.getElementById("lightboxClose");
    let activeTab = "dashboard";

    if (!tourImage || !tourTitle || !tourDesc || !tourDescriptionContainer || !wrapper || !lightbox || !lightboxImage || !lightboxClose) {
      return;
    }

    tabs.forEach(tab => {
      tab.addEventListener("click", () => {
        const currentTab = tab.getAttribute("data-tab");
        if (!currentTab || currentTab === activeTab) return;

        activeTab = currentTab;
        tabs.forEach(btn => btn.classList.remove("active"));
        tab.classList.add("active");

        // Transitions
        tourImage.classList.add("transitioning");
        tourDescriptionContainer.classList.add("transitioning");

        setTimeout(() => {
          const data = tourData[currentTab];
          if (data) {
            tourImage.src = data.src;
            tourImage.alt = `Open911 ${data.title}`;
            tourTitle.textContent = data.title;
            tourDesc.textContent = data.desc;
            lightboxImage.src = data.src;
            lightboxImage.alt = `Open911 ${data.title}`;
          }
          tourImage.classList.remove("transitioning");
          tourDescriptionContainer.classList.remove("transitioning");
        }, 150);
      });
    });

    // Lightbox bindings
    const showLightbox = () => {
      lightbox.classList.add("active");
      document.body.style.overflow = "hidden";
    };
    const hideLightbox = () => {
      lightbox.classList.remove("active");
      document.body.style.overflow = "";
    };

    wrapper.addEventListener("click", showLightbox);
    lightboxClose.addEventListener("click", hideLightbox);
    lightbox.addEventListener("click", (e) => {
      if (e.target === lightbox) hideLightbox();
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && lightbox.classList.contains("active")) hideLightbox();
    });
  }

  // Initialize immediately or on load
  if (document.readyState === 'loading') {
    document.addEventListener("DOMContentLoaded", initTour);
  } else {
    initTour();
  }
</script>
