---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';

const allPosts = await getCollection('blog');
const enPosts = allPosts.filter((p) => p.id.startsWith('en/'));
const koMap = new Map(
  allPosts.filter((p) => p.id.startsWith('ko/')).map((p) => [p.id.replace(/^ko\//, ''), p])
);

const posts = enPosts.map((enPost) => {
  const slug = enPost.id.replace(/^en\//, '');
  const koPost = koMap.get(slug);
  const isTranslated = !!koPost;
  const post = koPost || enPost;
  return {
    post,
    slug,
    isTranslated,
    pubDate: post.data.pubDate,
    title: post.data.title,
    description: post.data.description,
    author: post.data.author,
  };
});

for (const [slug, koPost] of koMap.entries()) {
  if (!posts.some((p) => p.slug === slug)) {
    posts.push({
      post: koPost,
      slug,
      isTranslated: true,
      pubDate: koPost.data.pubDate,
      title: koPost.data.title,
      description: koPost.data.description,
      author: koPost.data.author,
    });
  }
}

posts.sort((a, b) => b.pubDate.valueOf() - a.pubDate.valueOf());
---

<Layout
  title="블로그 | GxPSoft AI"
  description="자율형 AI 에이전트, GxP 검증, 안전한 백업 및 중요 시스템용 개발자 도구에 대한 인사이트."
  canonicalUrl="https://gxpsoft.ai/ko/blog.html"
  pageClass="page-blog"
  locale="ko"
>
  <Header slot="header" />

  <section class="hero-text" id="blogHero">
    <h1>GxPSoft AI 블로그</h1>
    <p>자율 소프트웨어 엔지니어링, 산업 시스템 및 GxP 규제 준수 자동화에 대한 기술 인사이트와 연구 결과.</p>
  </section>

  <section id="postsSection">
    <h2 class="section-title">최신 기사</h2>
    <div class="posts-list">
      {posts.length === 0 ? (
        <p class="no-posts">아직 등록된 기사가 없습니다. 곧 새로운 소식을 전해드리겠습니다!</p>
      ) : (
        posts.map((item) => (
          <article class="post-card">
            <div class="post-card-meta">
              <time datetime={item.pubDate.toISOString()} class="post-card-date">
                {item.pubDate.toLocaleDateString('ko-KR', {
                  year: 'numeric',
                  month: 'short',
                  day: '2-digit',
                })}
              </time>
              {item.author && <div class="post-card-author">{item.author}</div>}
              {!item.isTranslated && (
                <span class="lang-tag" title="한국어 번역 준비 중 (영문 제공)">영문</span>
              )}
            </div>
            <div class="post-card-body">
              <h2 class="post-card-title">
                <a href={`/ko/blog/${item.slug}.html`} class="post-card-link">
                  {item.title}
                </a>
              </h2>
              <p class="post-card-description">{item.description}</p>
            </div>
          </article>
        ))
      )}
    </div>
  </section>
</Layout>

<style>
  .posts-list {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin-top: 32px;
  }

  .post-card {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: 32px;
    padding: 32px 0;
    border-top: 1px solid var(--border-color);
    transition: transform 0.2s ease;
  }

  .post-card:first-of-type {
    border-top: none;
    padding-top: 12px;
  }

  .post-card:hover {
    transform: translateX(6px);
  }

  .post-card-body {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .post-card-meta {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-top: 6px;
  }

  .post-card-date {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-muted);
    letter-spacing: 0.05em;
    margin: 0;
  }

  .post-card-author {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-muted);
    line-height: 1.4;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-left: 1px solid var(--border-color);
    padding-left: 8px;
  }

  .lang-tag {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    padding: 2px 6px;
    border-radius: 4px;
    background: rgba(148, 163, 184, 0.12);
    color: var(--text-muted);
    border: 1px solid var(--border-color);
    width: fit-content;
  }

  .post-card-title {
    font-family: var(--font-serif);
    font-size: 24px;
    font-weight: 500;
    line-height: 1.3;
  }

  .post-card-link {
    color: var(--text-color);
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .post-card-link:hover {
    opacity: 0.8;
  }

  .post-card-description {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-muted);
    line-height: 1.6;
    margin: 0;
  }

  .no-posts {
    font-family: var(--font-mono);
    color: var(--text-muted);
    font-style: italic;
  }

  @media (max-width: 640px) {
    .post-card {
      grid-template-columns: 1fr;
      gap: 12px;
      padding: 24px 0;
    }
    .post-card:hover {
      transform: none;
    }
    .post-card-meta {
      padding-top: 0;
      flex-direction: row;
      align-items: center;
      gap: 16px;
      border-bottom: 1px solid var(--border-color);
      padding-bottom: 12px;
    }
    .post-card-author {
      border-left: 1px solid var(--border-color);
      padding-left: 16px;
    }
  }
</style>
