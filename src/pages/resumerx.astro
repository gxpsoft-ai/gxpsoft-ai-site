---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';

const resumerxSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "ResumeRx",
  "operatingSystem": "Web, Email Native",
  "applicationCategory": "BusinessApplication",
  "description": "ResumeRx matches life sciences professionals to biopharma job openings, generates customized keyword-optimized resumes, and sends them back to your inbox instantly.",
  "url": "https://gxpsoft.ai/resumerx.html",
  "offers": {
    "@type": "Offer",
    "price": "1.99",
    "priceCurrency": "USD"
  },
  "author": {
    "@type": "Organization",
    "name": "GxPSoft AI"
  }
};
---

<Layout
  title="ResumeRx | Email Your Resume, Get Matched to Biopharma Jobs"
  description="ResumeRx matches life sciences professionals to biopharma job openings, generates customized keyword-optimized resumes, and sends them back to your inbox instantly."
  canonicalUrl="https://gxpsoft.ai/resumerx.html"
  ogImage="https://gxpsoft.ai/images/resumerx_og_image_v3.png"
  pageClass="page-resumerx"
  schema={resumerxSchema}
>
  <Header slot="header" />

  <section class="hero-text subpage-hero" id="heroSection">
    <h1>ResumeRx: Email Your Resume. We'll Find Your Next Biopharma Role.</h1>
    
    <div class="alpha-banner" id="alphaBanner">
      <span class="alpha-tag">Early Alpha</span>
      <span class="alpha-text">ResumeRx is under active development. Please expect potential bugs and layout changes.</span>
    </div>

    <p>
      Send your resume to <strong>jobs@gxpsoft.ai</strong>. You'll receive an email back 
      with tailored applications matched to active job openings across hundreds of life 
      sciences companies — each one customized to the specific role and optimized to get 
      past screening systems.
    </p>
    <p>
      No apps. No portals. No forms. Just email. Built for people who work in
      biopharma, by people who understand biopharma.
    </p>
  </section>

  <section id="pipelineSection">
    <h2 class="section-title">How It Works</h2>
    <p style="margin-bottom: 16px; font-size: 13px; opacity: 0.8;">
      Five steps from your outbox to tailored applications.
    </p>

    <div class="pipeline-container">
      <div class="pipeline-steps" id="pipelineSteps">
        <button class="pipeline-step active" data-step="0">
          <span class="pipeline-step-number">01</span>
          <span class="pipeline-step-title">You Email Your Resume</span>
        </button>
        <button class="pipeline-step" data-step="1">
          <span class="pipeline-step-number">02</span>
          <span class="pipeline-step-title">We Read Between the Lines</span>
        </button>
        <button class="pipeline-step" data-step="2">
          <span class="pipeline-step-number">03</span>
          <span class="pipeline-step-title">We Find Your Matches</span>
        </button>
        <button class="pipeline-step" data-step="3">
          <span class="pipeline-step-number">04</span>
          <span class="pipeline-step-title">We Tailor Your Applications</span>
        </button>
        <button class="pipeline-step" data-step="4">
          <span class="pipeline-step-number">05</span>
          <span class="pipeline-step-title">Everything Lands in Your Inbox</span>
        </button>
      </div>

      <div class="pipeline-detail" id="pipelineDetail">
        <h3 class="pipeline-detail-title" id="pipelineTitle">01. You Email Your Resume</h3>
        <p class="pipeline-detail-text" id="pipelineDesc">
          Attach your resume to an email and send it to us. We accept .docx, .txt, and .md files. That's it — no accounts, no forms, no logins. If you send a PDF, we'll gently ask you to resend it in a format we can work with.
        </p>
      </div>
    </div>
  </section>

  <section id="featuresSection">
    <h2 class="section-title">Why People Use ResumeRx</h2>
    <div class="features-grid">
      <div class="feature-card">
        <h3>All Email, All the Time</h3>
        <p>There's no app to install, no dashboard to check, no password to remember. You send your resume from your inbox, and you receive your matches right back in your inbox. The entire experience happens where you already live — your email.</p>
      </div>
      <div class="feature-card">
        <h3>Built for Life Sciences</h3>
        <p>We understand biopharma because it's all we do. Our system knows what GxP means, why 21 CFR Part 11 matters, and how to value clinical operations experience versus general IT. Generic job boards don't speak your language — we do.</p>
      </div>
      <div class="feature-card">
        <h3>Every Link Works</h3>
        <p>Before we send you any job link, we verify it's live. No dead ends, no "this position has been filled," no redirects to generic career pages. You only get links that take you straight to the role you matched with.</p>
      </div>
      <div class="feature-card">
        <h3>Resumes Optimized for Screening Systems</h3>
        <p>Most large companies use software to screen resumes before a human ever sees them. Every resume we generate is formatted to sail through these systems — clean layout, standard headings, and keyword-optimized content that mirrors the job description.</p>
      </div>
    </div>
  </section>

  <section id="pricingSection">
    <h2 class="section-title">Pricing</h2>
    <div class="pricing-card">
      <div class="pricing-info">
        <span class="pricing-badge">7-Day Free Trial</span>
        <h3>Simple, Transparent Pricing</h3>
        <p class="pricing-description">
          Try ResumeRx risk-free. Find your next biopharma role and let our system optimize your applications. Cancel anytime with a single email.
        </p>
      </div>
      <div class="pricing-rate">
        <div class="price-display">
          <span class="price-amount">$1.99</span>
          <span class="price-period">/ month</span>
        </div>
        <p class="pricing-note">Starting after trial period ends.</p>
      </div>
    </div>
  </section>

  <section id="contactSection">
    <h2 class="section-title">Ready to Try It?</h2>
    <p class="section-text">
      Email your resume to <strong>jobs@gxpsoft.ai</strong> right now. You'll have tailored matches in your inbox shortly.
    </p>
    <p class="section-text" style="margin-top: 12px;">
      Questions? Interested in a custom deployment for your company or team?
    </p>
    <p class="section-text" style="margin-top: 8px;">
      Email:
      <a href="mailto:duke.lee@saram.io" class="service-link" id="emailLink">duke.lee@saram.io</a>
    </p>
    <p class="section-text">
      Phone:
      <a href="tel:+19253946606" class="service-link" id="phoneLink">925 394-6606</a>
    </p>
  </section>
</Layout>

<script>
  interface PipelineStep {
    number: string;
    title: string;
    description: string;
  }

  const pipelineStepsData: PipelineStep[] = [
    {
      number: "01",
      title: "You Email Your Resume",
      description: "Attach your resume to an email and send it to us. We accept .docx, .txt, and .md files. That's it — no accounts, no forms, no logins. If you send a PDF, we'll gently ask you to resend it in a format we can work with."
    },
    {
      number: "02",
      title: "We Read Between the Lines",
      description: "Our system parses your resume and identifies what makes you valuable: your technical skills, your domain expertise (GxP, clinical, manufacturing, regulatory), the roles you've held, and the companies you've worked at. We know life sciences — so we know what to look for."
    },
    {
      number: "03",
      title: "We Find Your Matches",
      description: "Your profile is matched against thousands of active job openings across hundreds of biopharma companies — from large pharma to emerging biotechs. We prioritize quality over quantity, ensuring diverse results across different companies rather than flooding you with similar roles."
    },
    {
      number: "04",
      title: "We Tailor Your Applications",
      description: "For each matching job, we generate a customized version of your resume — tuned to the specific role and company. Your experience stays the same, but the language is optimized to help you get past automated screening systems and in front of a hiring manager."
    },
    {
      number: "05",
      title: "Everything Lands in Your Inbox",
      description: "Shortly, you'll receive an email with your tailored resumes attached. Each file is clearly named (Company_Role.txt) so you know exactly what's what. The email also includes direct links to every job — click and apply."
    }
  ];

  function initPipeline() {
    const steps = document.querySelectorAll(".pipeline-step");
    const title = document.getElementById("pipelineTitle");
    const desc = document.getElementById("pipelineDesc");
    const detailContainer = document.getElementById("pipelineDetail");
    let activeIndex = 0;

    if (!title || !desc || !detailContainer) return;

    steps.forEach((btn, idx) => {
      btn.addEventListener("click", () => {
        if (idx === activeIndex) return;

        activeIndex = idx;
        steps.forEach((step, sIdx) => {
          step.classList.remove("active", "completed");
          if (sIdx === activeIndex) {
            step.classList.add("active");
          } else if (sIdx < activeIndex) {
            step.classList.add("completed");
          }
        });

        detailContainer.classList.add("transitioning");
        setTimeout(() => {
          const data = pipelineStepsData[activeIndex];
          if (data) {
            title.textContent = `${data.number}. ${data.title}`;
            desc.textContent = data.description;
          }
          detailContainer.classList.remove("transitioning");
        }, 120);
      });
    });
  }

  // Initialize immediately or on load
  if (document.readyState === 'loading') {
    document.addEventListener("DOMContentLoaded", initPipeline);
  } else {
    initPipeline();
  }
</script>
