---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';

const homeSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareSourceCode",
  "name": "GxPSoft AI Open Source Tools",
  "description": "GxPSoft AI builds secure, GxP-compliant open source developer tools and automation skills using advanced AI coding agents.",
  "codeRepository": "https://github.com/gxpsoft-ai",
  "author": {
    "@type": "Organization",
    "name": "GxPSoft AI"
  }
};
---

<Layout
  title="GxPSoft AI | Open Source AI Agents & Developer Tools"
  description="GxPSoft AI builds secure, GxP-compliant open source developer tools and automation skills using advanced AI coding agents."
  canonicalUrl="https://gxpsoft.ai/"
  pageClass="page-home"
  schema={homeSchema}
>
  <Header slot="header" />

  <section class="hero-text" id="heroSection">
    <h1>Open Source AI Agents for GxP & Critical Systems</h1>
    <p>We build open-source tools using autonomous AI agents.</p>
    <p>
      By combining state-of-the-art LLMs with structured knowledge and declarative validation,
      we empower developers to automate critical operations—such as secure backups, industrial systems
      telemetry, and GxP compliance routines—with speed and confidence.
    </p>
  </section>

  <section id="missionSection">
    <h2 class="section-title">AI-Agent Centric Development</h2>
    <p class="section-text">
      We believe that software engineering is shifting from manual coding to Agentic Orchestration.
      Our goal is to build the foundational "skills" and libraries that allow AI agents to navigate
      complex command-line utilities and industrial protocols safely. By wrapping standard tools (like Restic)
      and complex protocols (like OPC UA) into agent-friendly interfaces, we ensure perfect execution.
    </p>
  </section>

  <section id="contactSection">
    <h2 class="section-title">Contact & Collaboration</h2>
    <p class="section-text">
      For partnership opportunities, custom deployment configurations, or general support:
    </p>
    <p class="section-text" style="margin-top: 8px;">
      Email:
      <a href="mailto:info@saram.consulting" class="service-link" id="emailLink">info@saram.consulting</a>
    </p>
    <p class="section-text">
      Phone:
      <a href="tel:+19253946606" class="service-link" id="phoneLink">925 394-6606</a>
    </p>
    <p class="section-text">
      GitHub:
      <a href="https://github.com/gxpsoft-ai" class="service-link" id="gitLink">@gxpsoft-ai</a>
    </p>
  </section>
</Layout>

